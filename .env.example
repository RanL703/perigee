# Copy to .env for local development. Do not commit real credentials.
POSTGRES_USER=perigee
POSTGRES_PASSWORD=change-me-for-local-development
POSTGRES_DB=perigee
POSTGRES_PORT=5432

# CelesTrak GP JSON ingestion
CELESTRAK_CATALOG_URL=https://celestrak.org/NORAD/elements/gp.php?GROUP=active&FORMAT=JSON
CELESTRAK_CACHE_PATH=data/cache/celestrak_active.json
CELESTRAK_FETCH_RETRIES=3
CELESTRAK_FETCH_BACKOFF_SECONDS=1.0
OBJECT_LIMIT=250

# Optional local operator-assistant model
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:9b
OLLAMA_TIMEOUT_SECONDS=20
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
